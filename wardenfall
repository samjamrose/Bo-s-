{
/* UIManager — DOM layer: HUD, modal screens, floating combat text, world labels, banners,
   fade and the touch joystick. Game systems talk to it only through events and a few calls. */
RL.UIManager = class {
  constructor(g, root) {
    this.g = g; this.root = root; this.screen = null; this.args = {}; this.shownAt = 0; this.floatCount = 0; this.labelEls = {}; this.last = {};
    this.el = {};
    for (const id of ['hud', 'modal', 'floats', 'labels', 'fade', 'banner', 'joy', 'h-lvl', 'h-hp', 'h-hptxt', 'h-xp', 'h-gold', 'h-room', 'h-obj', 'h-boss', 'h-bossname', 'h-bossfill', 'h-bossphase', 'h-weapon', 'h-abilities', 'toast']) this.el[id] = root.querySelector('#' + id);
    this.bind();
  }
  bind() {
    const g = this.g;
    this.root.addEventListener('click', (e) => {
      const t = e.target.closest('[data-act]'); if (!t || t.disabled) return;
      if (t.dataset.guard && performance.now() - this.shownAt < 300) return;
      g.audio.unlock(); g.audio.play('click');
      const f = RL.UI.actions[t.dataset.act]; if (f) f(g, this, t.dataset, t);
    });
    this.root.addEventListener('input', (e) => {
      const t = e.target; if (!t.dataset || !t.dataset.set) return;
      g.save.data.settings[t.dataset.set] = parseFloat(t.value); g.applySettings(); g.save.save();
    });
    window.addEventListener('keydown', (e) => {
      if (this.screen === 'levelUp' && /^[1-3]$/.test(e.key) && performance.now() - this.shownAt > 300) g.pickUpgrade(+e.key - 1);
    });
    g.events.on('abilitiesChanged', () => this.buildAbilities());
    g.events.on('weaponChanged', (w) => { this.el['h-weapon'].innerHTML = RL.icon(w.icon, 24) + '<span>' + w.name + '</span>'; });
    g.events.on('roomEntered', (n) => { const i = RL.Data.roomTypes[n.type]; this.banner(i.label, i.objective, i.color); });
    g.events.on('roomCleared', (d) => { if (!d.silent) this.banner('Path open', 'Choose a door', '#59c9b0'); });
    g.events.on('waveStarted', (w) => { if (w.of > 1) this.toast('Wave ' + w.wave + ' of ' + w.of); });
    g.events.on('bossPhase', (p) => this.toast(p.label, 'boss'));
    g.events.on('levelUp', (l) => this.toast('Level ' + l, 'good'));
  }
  /* ---- modal screens ---- */
  show(name, args) {
    this.screen = name; this.args = args || {}; this.shownAt = performance.now(); this.refresh(); this.el.modal.hidden = false;
  }
  refresh() {
    if (!this.screen) return;
    const sc = this.el.modal.querySelector('.scroll'), top = sc ? sc.scrollTop : 0;
    this.el.modal.innerHTML = RL.UI.screens[this.screen](this.g, this.args);
    this.el.modal.className = 'modal screen-' + this.screen;
    const n = this.el.modal.querySelector('.scroll'); if (n) n.scrollTop = top;
  }
  hide() { this.screen = null; this.el.modal.hidden = true; this.el.modal.innerHTML = ''; }
  showHud(on) { this.el.hud.hidden = !on; this.el.labels.hidden = !on; if (!on) { this.clearLabels(); this.el.banner.className = 'banner'; } else { this.buildAbilities(); this.last = {}; } }
  setFade(v) { this.el.fade.style.opacity = String(v); }

  /* ---- transient text ---- */
  banner(title, sub, color) {
    const b = this.el.banner; b.innerHTML = `<b style="color:${color || 'var(--gold)'}">${title}</b><span>${sub || ''}</span>`;
    b.className = 'banner'; void b.offsetWidth; b.className = 'banner show';
  }
  toast(text, kind) {
    const t = this.el.toast; t.textContent = text; t.className = 'toast ' + (kind || ''); void t.offsetWidth; t.className = 'toast show ' + (kind || '');
  }
  float(x, z, text, cls, yoff) {
    const s = this.g.save.data.settings;
    if (!s.numbers && (!cls || cls === 'crit' || cls === 'dot')) return;
    if (this.floatCount > 36) return;
    const p = this.g.render.project(x, (yoff || 2.2), z); if (!p.visible) return;
    const d = document.createElement('div'); d.className = 'float ' + (cls || ''); d.textContent = text;
    d.style.left = (p.x + (Math.random() - 0.5) * 22) + 'px'; d.style.top = p.y + 'px'; this.el.floats.appendChild(d); this.floatCount++;
    setTimeout(() => { d.remove(); this.floatCount--; }, 800);
  }
  clearLabels() { for (const k of Object.keys(this.labelEls)) { this.labelEls[k].remove(); delete this.labelEls[k]; } this.el.floats.innerHTML = ''; this.floatCount = 0; }

  /* ---- HUD ---- */
  buildAbilities() {
    const g = this.g, wrap = this.el['h-abilities'];
    const slots = g.abilities.slots.map((s, i) => { const d = RL.Data.abilities[s.id]; return `<button class="aslot" data-act="cast" data-i="${i}" style="--c:#${d.color.toString(16).padStart(6, '0')}" aria-label="${d.name}">${RL.icon(d.icon, 26)}<i class="cd"></i><kbd>${i + 1}</kbd></button>`; });
    for (let i = g.abilities.slots.length; i < g.abilities.max; i++) slots.push(`<div class="aslot empty"><kbd>${i + 1}</kbd></div>`);
    wrap.innerHTML = slots.join('') + `<button class="aslot dash" data-act="dash" aria-label="Dash">${RL.icon('dash', 26)}<i class="cd"></i><kbd>Space</kbd></button>`;
    this.slotEls = Array.from(wrap.querySelectorAll('.aslot:not(.empty):not(.dash)')); this.dashEl = wrap.querySelector('.dash');
  }
  setText(key, el, v) { if (this.last[key] !== v) { this.last[key] = v; el.textContent = v; } }
  setWidth(key, el, v) { const s = (Math.round(v * 500) / 5) + '%'; if (this.last[key] !== s) { this.last[key] = s; el.style.width = s; } }
  update(dt) {
    const g = this.g, st = g.state, E = this.el;
    // joystick
    const j = g.input.joy; E.joy.hidden = !j.active;
    if (j.active) { E.joy.style.transform = `translate(${j.ox}px,${j.oy}px)`; E.joy.firstElementChild.style.transform = `translate(${j.x - j.ox}px,${j.y - j.oy}px)`; }
    if (E.hud.hidden || !g.run) return;
    const p = g.player;
    this.setText('lvl', E['h-lvl'], g.levels.level); this.setText('hp', E['h-hptxt'], Math.ceil(p.hp) + ' / ' + Math.round(p.maxHp));
    this.setWidth('hpw', E['h-hp'], p.hp / p.maxHp); this.setWidth('xpw', E['h-xp'], g.levels.ratio()); this.setText('gold', E['h-gold'], Math.floor(g.run.gold));
    const node = g.rooms.node;
    if (node && node.layer >= 0) {
      const info = RL.Data.roomTypes[node.type], total = g.run.map.layers.length;
      this.setText('room', E['h-room'], 'Room ' + (node.layer + 1) + ' of ' + total + ' · ' + info.label);
      let obj = info.objective; const rs = g.rooms.state;
      if (rs === 'cleared') obj = 'Choose a door'; else if (node.type === 'combat' || node.type === 'elite') obj = rs === 'active' ? 'Foes remaining: ' + g.rooms.remainingFoes() : 'Get ready';
      this.setText('obj', E['h-obj'], obj);
    }
    const b = g.boss;
    if (b && b.alive) { E['h-boss'].hidden = false; this.setText('bn', E['h-bossname'], b.def.name); this.setWidth('bf', E['h-bossfill'], b.hp / b.maxHp); this.setText('bp', E['h-bossphase'], b.phaseDef.label); } else E['h-boss'].hidden = true;
    if (this.slotEls) g.abilities.slots.forEach((s, i) => { const el = this.slotEls[i]; if (!el) return; const d = RL.Data.abilities[s.id], r = s.active ? 1 : s.cd / d.cooldown; el.style.setProperty('--cd', r.toFixed(3)); el.classList.toggle('ready', s.cd <= 0 && !s.active); el.classList.toggle('active', !!s.active); });
    if (this.dashEl) { const r = p.dashCd / g.stats.v.dashCooldown; this.dashEl.style.setProperty('--cd', r.toFixed(3)); this.dashEl.classList.toggle('ready', p.dashCd <= 0); }
