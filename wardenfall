    const labels = g.rooms.labels(), seen = {};
    for (const l of labels) {
      seen[l.key] = 1; let el = this.labelEls[l.key];
      if (!el) { el = document.createElement('div'); el.className = 'wlabel'; el.style.setProperty('--c', l.color); el.innerHTML = RL.icon(l.icon, 18) + '<span>' + l.text + '</span>'; E.labels.appendChild(el); this.labelEls[l.key] = el; }
      const sp = g.render.project(l.x, l.y, l.z); el.style.transform = `translate(${sp.x}px,${sp.y}px) translate(-50%,-100%)`; el.style.opacity = sp.visible ? '1' : '0';
    }
    for (const k of Object.keys(this.labelEls)) if (!seen[k]) { this.labelEls[k].remove(); delete this.labelEls[k]; }
  }
};

