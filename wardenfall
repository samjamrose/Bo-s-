/* ---- systems/ProceduralGenerationSystem ---- */
{
/* ProceduralGenerationSystem — seeded run maps. A run is an array of layers; each layer is
   an array of room nodes the player chooses between (via doors). Layouts for this prototype
   are picked from handcrafted templates; generateLayout() is the seam for fully procedural rooms. */
RL.ProcGen = {
  generateRun(regionId, seed) {
    const region = RL.Data.regions[regionId], rng = RL.U.mulberry32(seed), layers = [];
    const mk = (type, layer) => {
      const n = { id: layer + ':' + type, type, layer, seed: Math.floor(rng() * 1e9), layoutId: RL.ProcGen.pickLayout(type, rng) };
      n.waves = RL.ProcGen.generateWaves(n, region, rng); return n;
    };
    const side = RL.U.shuffle(['treasure', 'healing', 'merchant', 'event'], rng).slice(0, 2);
    const plan = [['combat'], ['combat'], side, ['combat'], ['elite'], ['healing'], ['boss']];
    plan.forEach((types, i) => layers.push(types.map((t) => mk(t, i))));
    return { regionId, seed, layers };
  },
  pickLayout(type, rng) {
    if (type === 'boss') return 'warden_court';
    if (type === 'combat' || type === 'elite') return RL.U.pick(RL.Data.combatLayouts, rng);
    return 'quiet_grove';
  },
  /* Wave composition scales with depth (layer index). */
  generateWaves(node, region, rng) {
    if (node.type !== 'combat' && node.type !== 'elite') return [];
    const L = node.layer, pool = region.enemies;
    const weight = (id) => ({ forest_goblin: 4, shadow_wolf: L >= 1 ? 2.5 : 0, bone_archer: L >= 1 ? 2 : 0, stoneback_beast: L >= 2 ? 1.5 + L * 0.3 : 0 }[id] || 0);
    const draw = (n) => { const out = []; for (let i = 0; i < n; i++) out.push(RL.U.weighted(pool, weight, rng)); return out; };
    if (node.type === 'elite') return [draw(4 + L), [region.elite].concat(draw(2))];
    const waveCount = L >= 3 ? 3 : 2, waves = [];
    for (let w = 0; w < waveCount; w++) waves.push(draw(Math.min(11, Math.round((3 + L * 1.1) * (1 + 0.12 * w)))));
    if (L >= 3 && rng() < 0.3) waves[waves.length - 1].push(region.elite);
    return waves;
  },
  /* Seam for future fully procedural layouts: returns the same shape as RL.Data.layouts entries. */
  generateLayout(seed, radius) {
    const rng = RL.U.mulberry32(seed), props = [], kinds = ['tree', 'rock', 'pillar', 'ruin'];
    for (let i = 0; i < 6; i++) {
      const a = rng() * 6.28, d = 6 + rng() * (radius - 10), t = kinds[Math.floor(rng() * kinds.length)];
      props.push({ t, x: Math.cos(a) * d, z: Math.sin(a) * d, r: t === 'rock' ? 1.3 : 1.0, s: 1 + rng() * 0.4 });
    }
    return { id: 'proc_' + seed, radius, name: 'Wild Glade', props };
  },
};

}
