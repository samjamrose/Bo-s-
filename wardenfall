RL.Events = class {
  constructor() { this.h = {}; }
  on(e, f) { (this.h[e] = this.h[e] || []).push(f); return () => this.off(e, f); }
  off(e, f) { const a = this.h[e]; if (a) { const i = a.indexOf(f); if (i >= 0) a.splice(i, 1); } }
  emit(e, d) { const a = this.h[e]; if (a) for (const f of a.slice()) f(d); }
  clear() { this.h = {}; }
};

RL.U = (function () {
  const TAU = Math.PI * 2;
  const U = {
    TAU,
    clamp: (v, a, b) => Math.max(a, Math.min(b, v)),
    lerp: (a, b, t) => a + (b - a) * t,
    rand: (a, b) => a + Math.random() * (b - a),
    randInt: (a, b) => Math.floor(a + Math.random() * (b - a + 1)),
    chance: (p) => Math.random() < p,
    pick: (arr, r) => arr[Math.floor((r || Math.random)() * arr.length)],
    dist: (ax, az, bx, bz) => Math.hypot(ax - bx, az - bz),
    angleDiff(a, b) {
      let d = (b - a) % TAU;
      if (d > Math.PI) d -= TAU;
      if (d < -Math.PI) d += TAU;
      return d;
    },
    weighted(items, wfn, r) {
      let total = 0;
      for (const it of items) total += wfn(it);
      if (total <= 0) return null;
      let x = (r || Math.random)() * total;
      for (const it of items) { x -= wfn(it); if (x <= 0) return it; }
      return items[items.length - 1];
    },
    mulberry32(seed) {
      let a = seed >>> 0;
      return function () {
        a |= 0; a = (a + 0x6d2b79f5) | 0;
        let t = Math.imul(a ^ (a >>> 15), 1 | a);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    },
    shuffle(arr, r) {
      const a = arr.slice(); const f = r || Math.random;
      for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(f() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; }
      return a;
    },
    pct: (v) => Math.round(v * 100) + '%',
    ease: (t) => t * t * (3 - 2 * t),
  };
  return U;
})();

