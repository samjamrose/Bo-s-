        <div class="ca">${sel ? '<span class="tag">Starts with</span>' : own ? `<button class="btn" data-act="select" data-slot="ability" data-id="${a.id}">Start with</button>` : H.costBtn(g, a.cost, `data-act="buy" data-kind="abilities" data-id="${a.id}"`)}</div></div>`;
