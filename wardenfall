        <div class="ca">${cost === null ? '<span class="tag">Max</span>' : H.costBtn(g, cost, `data-act="metaBuy" data-id="${u.id}"`)}</div></div>`;
    }).join('');
    return `<div class="panel">${H.head(g, 'Upgrades')}<div class="scroll"><p class="note">Permanent bonuses, kept between runs. Earn Aurels by collecting coins and clearing rooms.</p><div class="cards">${cards}</div></div></div>`;
