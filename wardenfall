    <button class="btn wide" data-act="shopLeave">Leave</button></div>`;

  const summary = (g, r, win) => `<div class="panel small center ${win ? 'win' : ''}"><p class="eyebrow">${win ? 'Greenwood Wilds' : 'Run ended'}</p>
    <h2 class="big-title">${win ? 'The Warden Falls' : 'Fallen on the Road'}</h2>
    <p class="story">${win ? 'The ruined gate grinds open and the road beyond catches the light.' : 'The Greenwood keeps what it takes, but your Aurels come home with you.'}</p>
    <div class="stats three"><div class="stat"><span>Rooms</span><b>${r.rooms}</b></div><div class="stat"><span>Foes</span><b>${r.kills}</b></div><div class="stat"><span>Level</span><b>${r.level}</b></div><div class="stat"><span>Time</span><b>${H.time(r.time)}</b></div></div>
    <div class="ledger"><div><span>Coins collected</span><b>${r.gold}</b></div><div><span>Rooms cleared</span><b>${r.roomPay}</b></div><div><span>Foes defeated</span><b>${r.killPay}</b></div>${r.bonus ? `<div><span>Victory bonus</span><b>${r.bonus}</b></div>` : ''}<div class="total"><span>Earned</span><b>${I('coin', 18)} ${r.award}</b></div></div>
    ${r.unlockedRegion ? `<p class="unlock">${I('lock', 16)} New region unlocked: ${RL.Data.regions[r.unlockedRegion].name}</p>` : ''}
    <div class="stack"><button class="btn primary big" data-act="go" data-screen="startRun">${I('play', 18)}<span>Another run</span></button><button class="btn" data-act="go" data-screen="upgrades">${I('star', 18)}<span>Spend Aurels</span></button><button class="btn ghost" data-act="go" data-screen="menu">Main menu</button></div></div>`;
  S.gameOver = (g, a) => summary(g, a.result, false);
  S.victory = (g, a) => summary(g, a.result, true);

  /* ---------- Actions ---------- */
  A.go = (g, ui, d) => { ui.show(d.screen); };
  A.begin = (g) => g.startRun();
  A.pause = (g) => g.pause();
  A.resume = (g) => g.resume();
  A.pauseSettings = (g, ui) => { ui.show('settings', { fromPause: true }); };
  A.abandonAsk = (g, ui) => ui.show('pause', { confirm: true });
  A.abandonConfirm = (g) => g.abandonRun();
  A.pick = (g, ui, d) => g.pickUpgrade(+d.i);
  A.eventOpt = (g, ui, d) => g.chooseEvent(+d.i);
  A.eventDone = (g) => g.closeEvent();
  A.shopBuy = (g, ui, d) => g.shopBuy(+d.i);
  A.shopLeave = (g) => g.closeShop();
  A.cast = (g, ui, d) => g.abilities.cast(+d.i, true);
  A.dash = (g) => g.player.tryDash();
  A.buy = (g, ui, d) => { if (g.progression.buyUnlock(d.kind, d.id)) { g.audio.play('gold'); } ui.refresh(); };
  A.metaBuy = (g, ui, d) => { if (g.progression.buyUpgrade(d.id)) g.audio.play('gold'); ui.refresh(); };
  A.select = (g, ui, d) => { g.progression.select(d.slot, d.id); if (d.slot === 'weapon' || d.slot === 'armor') g.refreshLoadout(); ui.refresh(); };
  A.region = (g, ui, d) => { g.progression.select('region', d.id); ui.refresh(); };
  A.toggle = (g, ui, d) => { const s = g.save.data.settings; s[d.key] = !s[d.key]; g.save.save(); g.applySettings(); ui.refresh(); };
  A.resetAsk = (g, ui) => ui.show('settings', { confirm: true });
  A.resetConfirm = (g, ui) => { g.save.reset(); g.progression.applyMeta(); g.refreshLoadout(); g.applySettings(); ui.show('settings', {}); };
})();

