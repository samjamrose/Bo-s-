<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"></head><body>
<title>Wardenfall</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alegreya+Sans:wght@400;500;700&family=Cinzel:wght@600;700;900&display=swap">
<style>
/* Layout: full-bleed 3D canvas, HUD pinned to the edges, modal screens centred over a dimmed scene. */
:root {
  --ink: #0b1513; --panel: #12211d; --panel2: #1a2e28; --line: #35544a; --gold: #e6bd62; --gold-dim: #a88a47;
  --text: #efe8d3; --mute: #9db2a7; --red: #d9544f; --teal: #59c9b0; --violet: #a98bff; --blue: #6fb8ff;
  --display: 'Cinzel', 'Trajan Pro', Georgia, serif; --body: 'Alegreya Sans', 'Segoe UI', system-ui, sans-serif;
  color-scheme: dark;
}
html, body { height: 100%; }
body { margin: 0; background: var(--ink); color: var(--text); font: 500 16px/1.35 var(--body); overflow: hidden; -webkit-tap-highlight-color: transparent; }
#app { position: relative; width: 100%; height: 100%; overflow: hidden; background: var(--ink); user-select: none; -webkit-user-select: none; }
#game { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; outline: none; }
#ui { position: absolute; inset: 0; pointer-events: none; }
#ui button, #ui input, .modal { pointer-events: auto; }
[hidden] { display: none !important; }
.ico { flex: none; }
kbd { font: 700 .8em var(--body); padding: .05em .45em; border: 1px solid var(--line); border-bottom-width: 2px; border-radius: 3px; background: var(--panel2); color: var(--gold); }
b { font-weight: 700; }

/* ---------- buttons ---------- */
.btn { display: inline-flex; align-items: center; justify-content: center; gap: .55rem; min-height: 44px; padding: .55rem 1.1rem; background: var(--panel2); color: var(--text); border: 1px solid var(--line); border-radius: 3px; font: 700 1rem var(--body); letter-spacing: .05em; cursor: pointer; transition: border-color .15s, background .15s, transform .1s; }
.btn:hover:not(:disabled) { border-color: var(--gold); background: #213a33; }
.btn:active:not(:disabled) { transform: translateY(1px); }
.btn:focus-visible, .choice:focus-visible, .aslot:focus-visible, .iconbtn:focus-visible, .loadrow:focus-visible, .switch:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
.btn:disabled { opacity: .45; cursor: default; }
.btn.primary { background: linear-gradient(#efce7e, #c99b3d); color: #231a07; border-color: #f6e3a5; text-shadow: 0 1px 0 rgba(255,255,255,.3); }
.btn.primary:hover:not(:disabled) { background: linear-gradient(#f6daa0, #d6a847); }
.btn.big { min-height: 54px; font-size: 1.12rem; }
.btn.wide { width: 100%; }
.btn.ghost { background: transparent; border-color: transparent; color: var(--mute); }
.btn.ghost:hover:not(:disabled) { color: var(--text); background: transparent; border-color: var(--line); }
.btn.warn { border-color: var(--red); color: #ffb3ad; }
.btn.buy { min-width: 84px; color: var(--gold); border-color: var(--gold-dim); }
.btn.buy:disabled { color: var(--mute); border-color: var(--line); }
.btn.opt { flex-direction: column; align-items: flex-start; gap: .1rem; text-align: left; letter-spacing: .02em; width: 100%; padding: .7rem 1rem; }
.btn.opt small { font-weight: 500; color: var(--mute); font-size: .92rem; letter-spacing: 0; }
.btn.opt:has(.oi) { flex-direction: row; align-items: center; gap: .9rem; }
.oi { color: var(--gold); display: flex; } .ot { flex: 1; display: flex; flex-direction: column; } .oc { display: inline-flex; align-items: center; gap: .3rem; color: var(--gold); font-weight: 700; }
.tag { display: inline-block; padding: .25rem .65rem; border: 1px solid var(--gold-dim); color: var(--gold); border-radius: 2px; font-weight: 700; font-size: .85rem; letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; }
.tag.dim { border-color: var(--line); color: var(--mute); }

/* ---------- modal + panels ---------- */
.modal { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; padding: 16px; background: rgba(5, 11, 9, .6); animation: fadein .25s ease; }
.screen-menu { justify-content: flex-start; background: linear-gradient(90deg, rgba(6,12,10,.9) 0%, rgba(6,12,10,.62) 42%, rgba(6,12,10,0) 78%); padding-left: max(16px, 6vw); }
.screen-levelUp { background: rgba(5, 11, 9, .72); }
.panel { width: min(900px, 100%); max-height: 100%; display: flex; flex-direction: column; min-height: 0; background: rgba(13, 25, 22, .94); border: 1px solid var(--line); border-radius: 4px; box-shadow: 0 0 0 3px rgba(13,25,22,.9), 0 0 0 4px var(--gold-dim), 0 20px 60px rgba(0,0,0,.55); }
.panel.narrow { width: min(640px, 100%); }
.panel.small { width: min(500px, 100%); padding: 1.6rem 1.5rem; gap: .9rem; overflow-y: auto; }
.panel.center { text-align: center; align-items: stretch; }
.sh { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 8px; padding: .8rem 1rem; border-bottom: 1px solid var(--line); }
.sh h2 { margin: 0; font: 700 1.5rem var(--display); letter-spacing: .1em; color: var(--gold); text-align: center; }
.sh .btn { justify-self: start; }
.sh .btn svg { transform: none; }
.aurel { justify-self: end; display: inline-flex; align-items: center; gap: .4rem; color: var(--gold); font-size: 1.15rem; }
.aurel.inline { justify-self: center; }
.aurel small { color: var(--mute); font-size: .85rem; }
.scroll { overflow-y: auto; padding: 1rem 1.2rem 1.3rem; display: flex; flex-direction: column; gap: 1.1rem; min-height: 0; overscroll-behavior: contain; }
h2, h3, h4 { margin: 0; }
.panel.small h2 { font: 700 1.7rem var(--display); letter-spacing: .08em; color: var(--gold); }
.big-title { font-size: 2rem !important; }
.sec { font: 700 .95rem var(--display); letter-spacing: .16em; text-transform: uppercase; color: var(--mute); margin-bottom: .6rem; padding-bottom: .4rem; border-bottom: 1px solid var(--line); }
.eyebrow { margin: 0; color: var(--teal); font-weight: 700; letter-spacing: .2em; text-transform: uppercase; font-size: .82rem; }
.note { margin: 0; color: var(--mute); }
.story { margin: 0; color: var(--mute); font-size: 1.05rem; }
.result { margin: 0; color: var(--text); font-size: 1.1rem; padding: .7rem .9rem; border-left: 3px solid var(--gold); background: var(--panel2); text-align: left; }
.stack { display: flex; flex-direction: column; gap: .6rem; }

/* ---------- menu ---------- */
.menu-main { display: flex; flex-direction: column; gap: 1rem; width: min(360px, 100%); }
.title { margin: 0; font: 900 clamp(3rem, 11vw, 5.6rem)/0.95 var(--display); letter-spacing: .04em; color: var(--text); text-shadow: 0 4px 24px rgba(0,0,0,.5); }
.title span { color: var(--gold); }
.menu-nav { display: grid; gap: .55rem; margin-top: .6rem; }
.menu-nav .btn { justify-content: flex-start; padding-left: 1.2rem; }
.menu-nav .btn.big { padding-left: 1.2rem; }
.menu-foot { display: flex; flex-wrap: wrap; gap: .4rem 1.1rem; margin: .5rem 0 0; color: var(--mute); font-size: .95rem; }
.menu-foot span { display: inline-flex; align-items: center; gap: .3rem; }

/* ---------- start run ---------- */
.hero-region h3 { font: 700 1.9rem var(--display); color: var(--gold); letter-spacing: .06em; margin: .2rem 0; }
.hero-region p { margin: 0; color: var(--mute); }
.hero-region { padding: 1rem 1.1rem; border: 1px solid var(--line); background: linear-gradient(120deg, rgba(76,128,66,.28), rgba(26,46,40,.4)); border-radius: 3px; }
.loadout { display: grid; gap: .5rem; }
.loadrow { display: grid; grid-template-columns: 28px 1fr auto auto; align-items: center; gap: .8rem; text-align: left; padding: .7rem 1rem; min-height: 48px; background: var(--panel2); color: var(--text); border: 1px solid var(--line); border-radius: 3px; cursor: pointer; font: 500 1rem var(--body); }
.loadrow:hover { border-color: var(--gold); }
.loadrow .k { color: var(--mute); } .loadrow b { color: var(--text); } .loadrow em { color: var(--gold); font-style: normal; font-size: .85rem; letter-spacing: .1em; text-transform: uppercase; }
.loadrow svg { color: var(--gold); }
.tips { padding: .8rem 1rem; border: 1px dashed var(--line); border-radius: 3px; color: var(--mute); }
.tips p { margin: .3rem 0 0; }

/* ---------- cards + stats ---------- */
.cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr)); gap: .7rem; }
.card { display: grid; grid-template-columns: 52px minmax(0, 1fr) auto; gap: .9rem; align-items: center; padding: .85rem; background: var(--panel2); border: 1px solid var(--line); border-radius: 3px; }
.card.sel { border-color: var(--gold); box-shadow: inset 0 0 0 1px rgba(230,189,98,.35); }
.card.locked { opacity: .65; }
.card .ci { width: 52px; height: 52px; display: grid; place-items: center; color: var(--c, var(--gold)); background: rgba(0,0,0,.28); border: 1px solid var(--c, var(--line)); border-radius: 3px; }
.card h4 { font: 700 1.05rem var(--display); letter-spacing: .05em; margin-bottom: .15rem; }
.card p { margin: 0; color: var(--mute); font-size: .98rem; }
.card small { color: var(--mute); display: block; margin-top: .3rem; font-size: .88rem; }
.cb { min-width: 0; }
.meters { display: grid; gap: 3px; margin-top: .5rem; }
.meter { display: grid; grid-template-columns: 56px 1fr; gap: .5rem; align-items: center; font-size: .82rem; color: var(--mute); }
.meter i { display: block; height: 5px; background: rgba(0,0,0,.4); border-radius: 2px; overflow: hidden; } .meter u { display: block; height: 100%; background: var(--gold); }
.pips { display: flex; gap: 4px; margin-top: .5rem; } .pips i { width: 16px; height: 6px; background: rgba(0,0,0,.4); border: 1px solid var(--line); } .pips i.on { background: var(--gold); border-color: var(--gold); }
.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: .5rem; }
.stats.three { grid-template-columns: repeat(auto-fit, minmax(80px, 1fr)); }
.stat { padding: .6rem .8rem; background: var(--panel2); border: 1px solid var(--line); border-radius: 3px; text-align: left; }
.stat span { display: block; color: var(--mute); font-size: .85rem; letter-spacing: .06em; text-transform: uppercase; }
.stat b { font-size: 1.4rem; font-variant-numeric: tabular-nums; }
.center .stat { text-align: center; }

/* ---------- settings ---------- */
.row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .8rem 0; border-bottom: 1px solid var(--line); min-height: 48px; }
.row.danger { border-bottom: 0; }
.row input[type=range] { width: min(240px, 50%); accent-color: var(--gold); height: 28px; }
.switch { width: 54px; height: 30px; padding: 3px; background: rgba(0,0,0,.4); border: 1px solid var(--line); border-radius: 15px; cursor: pointer; }
.switch i { display: block; width: 22px; height: 22px; border-radius: 50%; background: var(--mute); transition: transform .15s, background .15s; }
.switch.on { border-color: var(--gold); } .switch.on i { transform: translateX(24px); background: var(--gold); }

/* ---------- level up ---------- */
.levelup { width: min(980px, 100%); max-height: 100%; overflow-y: auto; text-align: center; display: flex; flex-direction: column; gap: .8rem; align-items: center; padding: 8px; }
.levelup h2 { font: 700 clamp(1.5rem, 4vw, 2.3rem) var(--display); letter-spacing: .1em; color: var(--gold); }
.choices { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .9rem; width: 100%; margin-top: .4rem; }
.choice { position: relative; display: flex; flex-direction: column; align-items: center; gap: .45rem; padding: 1.5rem 1rem 1.2rem; min-height: 230px; background: linear-gradient(#1b312a, #12211d); color: var(--text); border: 1px solid var(--rc, var(--line)); border-radius: 4px; cursor: pointer; font: 500 1rem var(--body); transition: transform .15s, box-shadow .15s; animation: rise .35s ease backwards; }
.choice:nth-child(2) { animation-delay: .06s; } .choice:nth-child(3) { animation-delay: .12s; }
.choice:hover { transform: translateY(-4px); box-shadow: 0 8px 30px rgba(0,0,0,.5), 0 0 0 1px var(--rc); }
.choice .cico { width: 62px; height: 62px; display: grid; place-items: center; color: var(--rc); border: 1px solid var(--rc); border-radius: 50%; background: rgba(0,0,0,.3); }
.choice b { font: 700 1.15rem var(--display); letter-spacing: .05em; }
.choice p { margin: 0; color: var(--mute); font-size: 1.02rem; }
.choice .rar { color: var(--rc); font-size: .8rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
.choice .key { position: absolute; top: 8px; left: 10px; color: var(--mute); font-size: .85rem; border: 1px solid var(--line); border-radius: 3px; padding: 0 .4rem; }
.r-common { --rc: #b8cfc6; } .r-rare { --rc: var(--blue); } .r-epic { --rc: var(--violet); }

/* ---------- summary ---------- */
.ledger { display: grid; gap: .3rem; padding: .7rem .9rem; border: 1px solid var(--line); background: var(--panel2); text-align: left; }
.ledger div { display: flex; justify-content: space-between; gap: 1rem; color: var(--mute); } .ledger b { color: var(--text); font-variant-numeric: tabular-nums; }
.ledger .total { border-top: 1px solid var(--line); padding-top: .4rem; margin-top: .2rem; color: var(--gold); font-weight: 700; font-size: 1.1rem; } .ledger .total b { color: var(--gold); display: inline-flex; align-items: center; gap: .3rem; }
.unlock { margin: 0; color: var(--teal); display: flex; gap: .4rem; justify-content: center; align-items: center; font-weight: 700; }
.win .big-title { color: #ffd77a; }

/* ---------- HUD ---------- */
#hud { position: absolute; inset: 0; }
#hud > * { position: absolute; }
.hud-tl { top: calc(12px + env(safe-area-inset-top, 0px)); left: 16px; display: flex; align-items: center; gap: 10px; }
.lvl { width: 48px; height: 48px; display: grid; place-content: center; text-align: center; background: radial-gradient(#243e35, #0f1b18); border: 2px solid var(--gold); border-radius: 50%; line-height: 1; box-shadow: 0 2px 10px rgba(0,0,0,.5); }
.lvl span { font-size: .6rem; letter-spacing: .15em; color: var(--mute); } .lvl b { font: 700 1.3rem var(--display); color: var(--gold); }
.bars { width: min(250px, 44vw); display: grid; gap: 5px; }
.bar { position: relative; background: rgba(5,10,9,.7); border: 1px solid rgba(0,0,0,.6); outline: 1px solid rgba(255,255,255,.12); border-radius: 2px; overflow: hidden; }
.bar i { display: block; height: 100%; width: 100%; transition: width .12s linear; }
.bar.hp { height: 20px; } .bar.hp i { background: linear-gradient(#e86a62, #b8403b); }
.bar.hp b { position: absolute; inset: 0; display: grid; place-items: center; font-size: .82rem; text-shadow: 0 1px 2px #000; font-variant-numeric: tabular-nums; }
.bar.xp { height: 8px; } .bar.xp i { background: linear-gradient(#7af0d4, #3aa890); width: 0; }
.hud-tr { top: calc(12px + env(safe-area-inset-top, 0px)); right: 16px; display: flex; gap: 10px; align-items: center; }
.gold { display: inline-flex; align-items: center; gap: .4rem; padding: .35rem .75rem; background: rgba(5,10,9,.7); border: 1px solid var(--gold-dim); border-radius: 3px; color: var(--gold); font-size: 1.15rem; font-variant-numeric: tabular-nums; }
.iconbtn { width: 44px; height: 44px; display: grid; place-items: center; background: rgba(5,10,9,.7); color: var(--text); border: 1px solid var(--line); border-radius: 3px; cursor: pointer; }
.iconbtn:hover { border-color: var(--gold); }
.hud-top { top: calc(72px + env(safe-area-inset-top, 0px)); left: 50%; transform: translateX(-50%); text-align: center; text-shadow: 0 1px 3px #000, 0 0 8px rgba(0,0,0,.8); width: max-content; max-width: calc(100% - 32px); }
#h-room { font-size: .85rem; letter-spacing: .14em; text-transform: uppercase; color: var(--mute); }
#h-obj { font: 700 1.1rem var(--display); letter-spacing: .06em; }
#h-boss { top: calc(118px + env(safe-area-inset-top, 0px)); left: 50%; transform: translateX(-50%); width: min(560px, calc(100% - 32px)); }
.bn { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; font: 700 1rem var(--display); letter-spacing: .08em; text-shadow: 0 1px 3px #000; }
.bn span { font: 600 .8rem var(--body); color: var(--teal); letter-spacing: .14em; text-transform: uppercase; }
.bbar { height: 14px; margin-top: 4px; background: rgba(5,10,9,.75); border: 1px solid var(--gold-dim); border-radius: 2px; overflow: hidden; } .bbar i { display: block; height: 100%; width: 100%; background: linear-gradient(#ff7a5e, #b5392c); transition: width .15s linear; }
.hud-bl { left: 16px; bottom: calc(18px + env(safe-area-inset-bottom, 0px)); display: flex; align-items: center; gap: .5rem; padding: .45rem .7rem; background: rgba(5,10,9,.65); border: 1px solid var(--line); border-radius: 3px; color: var(--text); font-weight: 700; letter-spacing: .04em; }
.hud-bl svg { color: var(--gold); }
.hud-bc { left: 50%; bottom: calc(18px + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%); display: flex; gap: 8px; }
.aslot { position: relative; width: 58px; height: 58px; display: grid; place-items: center; padding: 0; background: rgba(8,16,14,.82); color: var(--c, var(--text)); border: 1px solid var(--line); border-radius: 4px; cursor: pointer; overflow: hidden; }
.aslot.empty { border-style: dashed; opacity: .55; cursor: default; }
.aslot.dash { margin-left: 10px; color: var(--text); }
.aslot .cd { position: absolute; left: 0; right: 0; top: 0; height: calc(var(--cd, 0) * 100%); background: rgba(0,0,0,.66); pointer-events: none; }
.aslot kbd { position: absolute; right: 3px; bottom: 2px; padding: 0 .3rem; font-size: .62rem; background: rgba(0,0,0,.5); border: 0; color: var(--mute); }
.aslot.ready { border-color: var(--c, var(--gold)); box-shadow: 0 0 12px -2px var(--c, var(--gold)); } .aslot.dash.ready { border-color: var(--text); box-shadow: none; }
.aslot.active { background: rgba(60,50,20,.9); }
.wlabel { position: absolute; left: 0; top: 0; display: inline-flex; align-items: center; gap: .4rem; padding: .3rem .7rem; background: rgba(8,16,14,.82); border: 1px solid var(--c); color: var(--c); border-radius: 3px; font-weight: 700; letter-spacing: .06em; white-space: nowrap; text-shadow: 0 1px 2px #000; will-change: transform; }
#labels, #floats { position: absolute; inset: 0; overflow: hidden; }
.float { position: absolute; transform: translate(-50%, -50%); font: 700 1.1rem var(--body); color: #fff; text-shadow: 0 1px 3px #000, 0 0 6px rgba(0,0,0,.6); animation: floatup .8s ease-out forwards; white-space: nowrap; }
.float.crit { color: var(--gold); font-size: 1.5rem; } .float.dot { color: #ffa44a; font-size: .95rem; } .float.hurt { color: #ff6a62; font-size: 1.5rem; }
.float.heal { color: #7af0a0; } .float.dodge { color: var(--blue); font-style: italic; }
.banner { position: absolute; left: 0; right: 0; top: 24%; text-align: center; display: grid; gap: .2rem; pointer-events: none; opacity: 0; text-shadow: 0 2px 10px rgba(0,0,0,.8); }
.banner b { font: 900 clamp(1.8rem, 6vw, 3.2rem) var(--display); letter-spacing: .12em; text-transform: uppercase; }
.banner span { font-size: 1.15rem; letter-spacing: .12em; color: var(--text); text-transform: uppercase; }
.banner.show { animation: banner 2.4s ease forwards; }
.toast { position: absolute; left: 50%; top: 36%; transform: translateX(-50%); padding: .4rem 1.1rem; background: rgba(8,16,14,.8); border: 1px solid var(--gold-dim); color: var(--gold); font: 700 1.1rem var(--display); letter-spacing: .1em; opacity: 0; pointer-events: none; white-space: nowrap; }
.toast.boss { color: #7af0d4; border-color: #3aa890; } .toast.good { color: #7af0a0; }
.toast.show { animation: toast 1.8s ease forwards; }
#joy { position: absolute; left: 0; top: 0; width: 0; height: 0; pointer-events: none; }
#joy::before { content: ''; position: absolute; width: 112px; height: 112px; left: -56px; top: -56px; border-radius: 50%; border: 2px solid rgba(239,232,211,.35); background: rgba(239,232,211,.06); }
#joy i { position: absolute; width: 46px; height: 46px; left: -23px; top: -23px; border-radius: 50%; background: rgba(239,232,211,.45); border: 2px solid rgba(239,232,211,.7); }
#fade { position: absolute; inset: 0; background: #050a09; opacity: 0; pointer-events: none; }
#boot { position: absolute; inset: 0; display: grid; place-items: center; text-align: center; background: var(--ink); padding: 24px; z-index: 5; }
#boot h1 { font: 900 2.4rem var(--display); color: var(--gold); letter-spacing: .1em; margin: 0 0 .5rem; }
#boot p { margin: 0; color: var(--mute); }

@keyframes fadein { from { opacity: 0; } to { opacity: 1; } }
@keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
@keyframes floatup { 0% { opacity: 0; transform: translate(-50%, -30%) scale(.7); } 15% { opacity: 1; transform: translate(-50%, -60%) scale(1.1); } 100% { opacity: 0; transform: translate(-50%, -190%) scale(1); } }
@keyframes banner { 0% { opacity: 0; transform: translateY(10px); } 15% { opacity: 1; transform: none; } 75% { opacity: 1; } 100% { opacity: 0; } }
@keyframes toast { 0% { opacity: 0; transform: translate(-50%, 8px); } 12% { opacity: 1; transform: translate(-50%, 0); } 80% { opacity: 1; } 100% { opacity: 0; } }
@media (prefers-reduced-motion: reduce) { .choice, .modal { animation: none; } .banner.show, .toast.show { animation-duration: 0.01s; opacity: 1; } .float { animation-duration: .5s; } }

@media (max-width: 640px) {
