    g.hookEvents();
    window.addEventListener('resize', () => g.render.resize());
    if (window.ResizeObserver) new ResizeObserver(() => g.render.resize()).observe(canvas);
    document.addEventListener('visibilitychange', () => { if (document.hidden && g.state === 'playing') g.pause(); });
    window.addEventListener('pointerdown', () => g.audio.unlock(), { passive: true });
    g.toMenu();
  }
  float(x, z, text, cls, yoff) { this.ui.float(x, z, text, cls, yoff); }
  applySettings() {
    const s = this.save.data.settings; this.audio.setVolume(s.volume); this.render.noShake = !s.shake;
    if (this.render.shadowsOn !== !!s.shadows) this.render.setShadows(s.shadows);
  }
  previewStats() {
    const ps = new RL.PlayerStats(), d = this.save.data, mods = [];
    for (const id of Object.keys(RL.Data.metaUpgrades)) { const def = RL.Data.metaUpgrades[id], l = d.upgrades[id] || 0; for (const m of def.mods) mods.push({ stat: m.stat, add: (m.add || 0) * l, pct: (m.pct || 0) * l }); }
    ps.setSource('meta', mods); ps.setSource('armor', RL.Data.armors[d.selected.armor].mods); return ps.v;
  }
  /* Rebuild player model/weapon from the saved loadout (menu preview and run start). */
  refreshLoadout() {
    const d = this.save.data;
    if (!this.save.has('armors', d.selected.armor)) d.selected.armor = 'traveler_cloak';
    if (!this.save.has('weapons', d.selected.weapon)) d.selected.weapon = 'iron_sword';
    if (!this.save.has('abilities', d.selected.ability)) d.selected.ability = 'flaming_strike';
    this.progression.applyMeta(); this.inventory.equipArmor(d.selected.armor); this.inventory.equipWeapon(d.selected.weapon);
  }
  hookEvents() {
    const g = this, ev = g.events;
    ev.on('enemyKilled', (e) => {
      if (!g.run) return; g.run.kills++;
      const s = g.stats.v; if (s.killHeal) g.player.heal(s.killHeal);
      if (e.def.elite && s.eliteHeal) g.player.heal(g.player.maxHp * s.eliteHeal);
    });
    ev.on('levelUp', () => { g.audio.play('level'); g.fx.ring(g.player.x, g.player.z, 5, 0xffe08a, 0.7); g.fx.burst(g.player.x, 1, g.player.z, 0xffe08a, 18, 5); g.float(g.player.x, g.player.z, 'Level up', 'heal'); });
    ev.on('playerDied', () => { g.setState('dying'); g.deathT = 1.7; g.audio.play('roar'); });
    ev.on('bossKilled', () => { g.victoryT = 3.6; g.run.bossKilled = true; g.audio.play('level'); g.render.shake(0.8); g.ui.banner('The Warden Falls', 'The way is open', '#ffd24a'); });
  }
  setState(s) {
    this.state = s; this.input.enabled = s === 'playing'; this.input.flush();
    if (s !== 'playing') this.input.releaseJoy();
  }

  /* ---- flow ---- */
  toMenu() {
    this.enemiesClear(); this.run = null; this.boss = null; this.trans = null; this.ui.setFade(0);
    this.player.reset(); this.rooms.enterMenu(); this.setState('menu'); this.ui.showHud(false); this.ui.show('menu');
  }
  enemiesClear() { this.enemies.clear(); this.projectiles.clear(); this.tele.clear(); }
  startRun() {
    const g = this, d = g.save.data;
    g.ui.hide(); g.upgrades.reset(); g.stats.setSource('tonic', []); g.freePicks = []; g.choices = [];
    g.refreshLoadout(); g.player.reset(); g.levels.reset(); g.abilities.reset(); g.inventory.reset();
    g.abilities.equip(d.selected.ability); g.run = g.progression.startRun(); g.run.regionId = d.selected.region;
    g.map = g.run.map = RL.ProcGen.generateRun(g.run.regionId, Math.floor(Math.random() * 1e9));
    g.player.reset(); g.victoryT = 0; g.boss = null;
    g.rooms.enter(g.map.layers[0][0]); g.setState('playing'); g.ui.showHud(true); g.ui.setFade(0);
    g.weapons.setWeapon(d.selected.weapon);
  }
  travel(node) { if (this.trans) return; this.trans = { t: 0, phase: 0, node }; this.setState('transition'); this.audio.play('door'); }
  pause() { if (this.state !== 'playing') return; this.setState('paused'); this.ui.show('pause'); }
  resume() { if (this.state !== 'paused') return; this.ui.hide(); this.setState('playing'); }
  abandonRun() { if (!this.run) return; this.ui.hide(); this.endRun(false, true); }
  endRun(victory) {
    const r = this.progression.finishRun(victory); this.setState('over'); this.ui.showHud(false);
    this.ui.show(victory ? 'victory' : 'gameOver', { result: r });
  }

  /* ---- level-ups and picks ---- */
  queueUpgrade(source) { this.freePicks.push(source); }
  processPicks() {
    if (this.state !== 'playing') return;
    let src = null;
    if (this.freePicks.length) src = this.freePicks.shift(); else if (this.levels.pending > 0) { this.levels.pending--; src = 'level'; }
    if (!src) return;
    this.choices = this.upgrades.roll(3, src); this.pickSource = src; this.setState('levelup');
    this.ui.show('levelUp', { choices: this.choices, source: src });
  }
  pickUpgrade(i) {
    if (this.state !== 'levelup' || !this.choices[i]) return;
    this.upgrades.apply(this.choices[i]); if (this.pickSource === 'level') this.player.heal(this.player.maxHp * 0.12);
    this.audio.play('level'); this.choices = []; this.ui.hide(); this.setState('playing'); this.ui.buildAbilities();
  }
  openEvent(ev) { this.setState('event'); this.ui.show('event', { event: ev }); }
  chooseEvent(i) {
    if (this.state !== 'event') return; const ev = this.ui.args.event, opt = ev.options[i]; if (!opt) return;
    const result = opt.run(this) || ''; this.ui.show('event', { event: ev, result });
  }
  closeEvent() { this.ui.hide(); this.setState('playing'); this.rooms.clear(); }
  openShop(stock) { this.setState('shop'); this.ui.show('shop', { stock }); }
  shopBuy(i) {
    const s = this.ui.args.stock[i]; if (!s || s.sold || this.run.gold < s.cost) return;
    this.run.gold -= s.cost; s.sold = true; s.run(this); this.audio.play('gold'); this.ui.refresh();
  }
  closeShop() { this.ui.hide(); this.setState('playing'); }

  /* ---- loop ---- */
  start() { this.last = performance.now(); const loop = (now) => { requestAnimationFrame(loop); const dt = Math.min(0.05, (now - this.last) / 1000); this.last = now; this.tick(dt); }; requestAnimationFrame(loop); }
  tick(dt) {
    this.time += dt; const s = this.state;
    if (s === 'playing' || s === 'dying') this.step(dt);
    else if (s === 'transition') this.stepTransition(dt);
    else if (s === 'menu' || s === 'over') this.stepMenu(dt);
    else if (s === 'paused' && this.input.consumePause()) this.resume();
    this.ui.update(dt); this.render.render();
  }
  stepMenu(dt) {
    const a = this.time * 0.12, cam = this.render.camera, m = this.player.model, p = this.player;
    if (this.rooms.env) this.rooms.env.update(dt, p.x, p.z);
    if (m && this.state === 'menu') { m.group.position.set(0, 0, 0); m.update(dt, 0, 0); }
    const cx = this.state === 'menu' ? 0 : p.x, cz = this.state === 'menu' ? 0 : p.z;
    cam.position.set(cx + Math.sin(a) * 9.5, 4.6, cz + Math.cos(a) * 9.5); cam.lookAt(cx, 1.7, cz);
  }
  stepTransition(dt) {
    const t = this.trans; t.t += dt;
    if (t.phase === 0) { this.ui.setFade(Math.min(1, t.t / 0.3)); if (t.t >= 0.3) { this.rooms.enter(t.node); t.phase = 1; t.t = 0; } }
    else { this.ui.setFade(Math.max(0, 1 - t.t / 0.35)); if (t.t >= 0.35) { this.trans = null; this.ui.setFade(0); this.setState('playing'); } }
  }
  step(dt) {
    const g = this;
    if (g.state === 'playing') {
      for (const i of g.input.consumeAbilities()) g.abilities.cast(i, true);
      if (g.input.consumePause()) { g.pause(); return; }
    }
    g.run.time += dt;
    g.player.update(dt); g.weapons.update(dt); g.abilities.update(dt); g.allies.update(dt); g.enemies.update(dt); g.projectiles.update(dt);
    g.tele.update(dt); g.loot.update(dt); g.rooms.update(dt); g.fx.update(dt);
    g.render.follow(g.player.x, g.player.z, dt);
    if (g.state === 'playing') {
      g.processPicks();
      if (g.victoryT > 0 && g.state === 'playing') { g.victoryT -= dt; if (g.victoryT <= 0) g.endRun(true); }
    } else if (g.state === 'dying') { g.deathT -= dt; if (g.deathT <= 0) g.endRun(false); }
  }
};

RL.boot = function () {
  const canvas = document.getElementById('game'), root = document.getElementById('ui'), boot = document.getElementById('boot');
  try {
    if (typeof THREE === 'undefined') throw new Error('The 3D engine could not be loaded. Check your connection and reload.');
    const game = (window.game = new RL.Game(canvas, root)); game.start(); if (boot) boot.hidden = true;
  } catch (err) {
    if (boot) { boot.hidden = false; boot.querySelector('p').textContent = err && err.message ? err.message : String(err); }
    if (window.console) console.error(err);
  }
};

}
</script>
<script>RL.boot();</script>

