  S.shop = (g, a) => `<div class="panel small"><p class="eyebrow">Wandering trader</p><h2>Wares</h2><p class="story">"Coin for comfort, friend. The road is long."</p><div class="aurel inline">${I('coin', 18)}<b>${g.run.gold}</b><small>Aurels this run</small></div>
