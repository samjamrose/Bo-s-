      let action = '<span class="tag dim">Locked</span>';
      if (open && r.implemented) action = sel ? '<span class="tag">Selected</span>' : `<button class="btn" data-act="region" data-id="${r.id}">Select</button>`;
      else if (open) action = '<span class="tag dim">Not yet charted</span>';
      return `<div class="card tall ${sel ? 'sel' : ''} ${open ? '' : 'locked'}"><div class="ci" style="--c:${r.implemented ? '#6fbf5a' : '#6b7d76'}">${I(open ? 'door' : 'lock', 26)}</div><div class="cb"><h4>${r.name}</h4><p>${r.blurb}</p><small>${r.hazards ? 'Hazards: ' + r.hazards.join(', ') : ''}</small></div><div class="ca">${action}</div></div>`;
